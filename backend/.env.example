# ==============================================================================
# ENGRAM ENVIRONMENT CONFIGURATION
# ==============================================================================

# Nebius Token Factory (OpenAI-compatible)
# Get your key at: https://tokenfactory.nebius.com/
NEBIUS_API_KEY=your_nebius_api_key_here
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# NVIDIA Models on Nebius Token Factory
# Ultra/Super model for deep synthesis, adversarial challenges, cognitive replay
NVIDIA_REASONING_MODEL=nvidia/nemotron-4-340b-instruct
# Fast/Nano model for routing, tag extraction, quick classification
NVIDIA_FAST_MODEL=nvidia/nemotron-3-nano

# Tavily AI Search API ($3K Hackathon Bonus Prize)
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Epistemic Storage Paths (defaults to ./data relative to backend)
DATA_DIR=./data

# Instagram Extraction Session (Optional - for private/saved reels)
INSTAGRAM_SESSION_ID=
