# Nebius Token Factory API Key (Inference on NVIDIA H100 / H200 Clusters)
# Get your key at: https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here

# Tavily AI Search API Key (Bonus Prize Category)
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Morning Dispatch Webhook (Discord / Slack / Telegram incoming webhook)
# If left blank, AntiTheca defaults to a safe mock endpoint (https://httpbin.org/post)
MORNING_DISPATCH_WEBHOOK=https://httpbin.org/post

# Next.js Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
