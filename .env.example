# Nebius Token Factory API Key (Inference on NVIDIA H100 / H200 Clusters)
# Get your key at: https://tokenfactory.nebius.com
NEBIUS_API_KEY=your_nebius_api_key_here

# Tavily AI Search API Key (Bonus Prize Category)
# Get your key at: https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Morning Dispatch Webhook (Discord / Slack / Telegram incoming webhook)
# If left blank, AntiTheca defaults to a safe mock endpoint (https://httpbin.org/post)
MORNING_DISPATCH_WEBHOOK=https://httpbin.org/post

# Next.js Frontend Configuration
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Social Media Extraction (Instagram / TikTok / YouTube)
# Cloud datacenter IPs are often blocked by Meta & ByteDance with CAPTCHAs.
# Optional: Configure a residential proxy pool (e.g. BrightData, Smartproxy, IPRoyal)
# RESIDENTIAL_PROXY_URL=http://user:password@geo.residentialproxy.net:10000
# Optional: Authenticated sessions for Instagram & TikTok
# INSTAGRAM_SESSION_ID=your_instagram_sessionid_cookie
# INSTAGRAM_COOKIES_FILE=/path/to/instagram_cookies.txt
# TIKTOK_SESSION_ID=your_tiktok_sessionid_cookie
# TIKTOK_COOKIES_FILE=/path/to/tiktok_cookies.txt
